# /etc/wireguard/wg0.conf - exemplo (o arquivo real NUNCA vai para o Git)
[Interface]
Address    = 10.200.0.1/24
ListenPort = <PORTA_WG>
PrivateKey = <CHAVE_PRIVADA_DO_SERVIDOR>

[Peer]
# MikroTik
PublicKey  = <CHAVE_PUBLICA_MIKROTIK>
AllowedIPs = 10.200.0.2/32

[Peer]
# Notebook
PublicKey  = <CHAVE_PUBLICA_NOTEBOOK>
AllowedIPs = 10.200.0.3/32
